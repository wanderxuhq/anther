{
  "name": "@wanderxuhq/anther",
  "version": "0.1.2",
  "description": "Mobile-first, browser-based code viewer/editor",
  "license": "ISC",
  "author": "wanderxuhq",
  "type": "module",
  "bin": {
    "anther": "./bin/anther.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin",
    "README.*.md"
  ],
  "scripts": {
    "test": "node --test --experimental-transform-types 'server/**/*.test.ts' 'web/src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch --experimental-transform-types server/cli.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "prepack": "npm run build",
    "start": "node bin/anther.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "solid-js": "^1.9.14",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0",
    "vscode-languageserver-protocol": "^3.18.2",
    "ws": "^8.21.3",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "jsdom": "^30.1.1",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.14",
    "yauzl": "^3.4.0"
  }
}
